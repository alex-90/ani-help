{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/home/alex/domains/kkkk": "${workspaceFolder}"
            }
        },
        {
            "name": "Launch yii serve & debug",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/yii",
            "args": ["serve", "0.0.0.0:8080"],
            "cwd": "${workspaceFolder}",
            "port": 9003,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ]
        },
        {
            "name": "Debug current CLI script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "port": 9003,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ]
        }
    ]
}
